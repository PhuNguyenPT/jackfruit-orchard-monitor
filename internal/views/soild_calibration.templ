package views

import (
	"GoApp/internal/database"
	"fmt"
)

templ SoilCalibrationAdminPage(cals []database.SoilCalibration, lang, userName string, site SiteConfig, status string) {
	<!DOCTYPE html>
	<html lang={ lang }>
		@Head(SEOMeta{
			Title:       T(lang).SoilCalibrationTitle,
			Description: T(lang).SoilCalibrationDescription,
		})
		<body class="min-h-screen bg-gray-50 flex flex-col">
			@Header("admin", userName, lang)
			<main class="flex-1">
				<div class="max-w-2xl mx-auto px-8 py-12 space-y-6">
					<div>
						<h1 class="text-3xl font-bold">{ T(lang).SoilCalibrationHeading }</h1>
						<p class="text-sm text-gray-500 mt-1">{ T(lang).SoilCalibrationSubtitle }</p>
					</div>
					<!-- OOB target for edge-case errors that can't be tied to a specific row -->
					<div id="soil-cal-toast"></div>
					<!-- No-JS fallback banner, still driven by ?status= for users without JS -->
					if status == "saved" {
						<div class="p-3 bg-green-100 border border-green-400 text-green-700 rounded-lg text-sm">
							{ T(lang).SoilCalibrationSaved }
						</div>
					} else if status == "error" {
						<div class="p-3 bg-red-100 border border-red-400 text-red-700 rounded-lg text-sm">
							{ T(lang).SoilCalibrationSaveFailed }
						</div>
					}
					if len(cals) == 0 {
						<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 text-center text-gray-400">
							<p class="text-sm">{ T(lang).SoilCalibrationNoData }</p>
						</div>
					} else {
						<div class="space-y-3">
							for _, cal := range cals {
								@SoilCalibrationRow(cal, lang, "")
							}
						</div>
					}
				</div>
			</main>
			@Footer(lang, site)
		</body>
	</html>
}

// Exported so soil_calibration.go (package server) can render a single row
// as an htmx fragment response, independent of the full page.
templ SoilCalibrationRow(cal database.SoilCalibration, lang string, rowStatus string) {
	<form
		id={ fmt.Sprintf("soil-row-%d", cal.SensorIdx) }
		hx-post="/admin/soil-calibration"
		hx-target={ fmt.Sprintf("#soil-row-%d", cal.SensorIdx) }
		hx-swap="outerHTML"
		method="POST"
		action="/admin/soil-calibration"
		class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 flex items-center gap-4"
	>
		<input type="hidden" name="sensor_idx" value={ fmt.Sprintf("%d", cal.SensorIdx) }/>
		<span class="font-semibold w-24 shrink-0">{ T(lang).SoilCalibrationSensor } { fmt.Sprintf("%d", cal.SensorIdx) }</span>
		<label class="text-sm text-gray-500 flex items-center gap-2">
			{ T(lang).SoilCalibrationDryLabel }
			<input type="number" name="dry_value" min="0" max="4095" value={ fmt.Sprintf("%d", cal.DryValue) } class="border rounded px-2 py-1 w-24"/>
		</label>
		<label class="text-sm text-gray-500 flex items-center gap-2">
			{ T(lang).SoilCalibrationWetLabel }
			<input type="number" name="wet_value" min="0" max="4095" value={ fmt.Sprintf("%d", cal.WetValue) } class="border rounded px-2 py-1 w-24"/>
		</label>
		if rowStatus == "saved" {
			<span class="soil-cal-badge text-emerald-600 text-xs font-medium">{ T(lang).SoilCalibrationSaved }</span>
		} else if rowStatus == "error" {
			<span class="soil-cal-badge text-red-600 text-xs font-medium">{ T(lang).SoilCalibrationSaveFailed }</span>
		}
		<button type="submit" class="ml-auto bg-emerald-600 text-white text-sm px-4 py-1.5 rounded-lg hover:bg-emerald-700 transition-colors">
			{ T(lang).SoilCalibrationSaveButton }
		</button>
	</form>
}

templ SoilCalibrationToast(lang, status string) {
	<div id="soil-cal-toast" hx-swap-oob="true">
		if status == "error" {
			<div class="soil-cal-badge p-3 bg-red-100 border border-red-400 text-red-700 rounded-lg text-sm">
				{ T(lang).SoilCalibrationSaveFailed }
			</div>
		}
	</div>
}
